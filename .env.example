# Optional runtime overrides. Set these in your shell or container environment.
# The browser workflow and evidence analysis require no credentials.

# full   local, the pipeline is importable
# replay hosted, serves the committed evidence bundle only
# demo   hosted synthetic experiments; browser isolation and quotas, no uploads
SIDEKICK_MODE=full
SIDEKICK_LOG_LEVEL=INFO
# SIDEKICK_TRAIN_THREADS=1
# Other reverse proxies: set the externally visible origin for hosted demo requests.
# Render provides RENDER_EXTERNAL_URL automatically.
# SIDEKICK_PUBLIC_ORIGIN=https://your-demo.example

# Paths default to the repository root.
# SIDEKICK_DATA_DIR=data
# SIDEKICK_ARTIFACTS_DIR=artifacts
# SIDEKICK_BUNDLE_PATH=evidence/bundle.json
# SIDEKICK_STATIC_DIR=frontend/dist

# MLflow is optional; the evidence store remains the source of truth.
SIDEKICK_MLFLOW=1
# MLFLOW_TRACKING_URI=file:./mlruns

# Empty in development: Vite proxies /api to the local backend.
# VITE_API_BASE=
SIDEKICK_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Explicit Deep investigation only; routine app analysis never calls the provider.
# Keep the actual key in your server environment.
# Nebius hackathon configuration (explicit opt-in; OpenAI remains the compatibility default).
# SIDEKICK_ASSISTANT_PROVIDER=nebius
# NEBIUS_API_KEY=
# SIDEKICK_NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# SIDEKICK_ASSISTANT_MODEL=nvidia/nemotron-3-super-120b-a12b
# Nemotron reasons by default; reasoning tokens count against max_tokens.
# SIDEKICK_NEBIUS_REASONING_EFFORT=low   # none, minimal, low, medium or high
# SIDEKICK_NEBIUS_REASONING_TOKENS=4096  # extra completion budget reserved for reasoning
# Check model/JSON/tool support for your endpoint with scripts/check_nebius.py --live.
# Legacy OpenAI configuration: select SIDEKICK_ASSISTANT_PROVIDER=openai.
# OPENAI_API_KEY=
# SIDEKICK_ASSISTANT_MODEL=gpt-4.1-mini-2025-04-14
# SIDEKICK_ASSISTANT_LIVE_ENABLED=1
# SIDEKICK_ASSISTANT_TASKS=investigate,compare,warning,brief,data,deep
# SIDEKICK_MAX_TOOL_CALLS=8
# SIDEKICK_ASSISTANT_TIMEOUT=45
# SIDEKICK_ASSISTANT_PRESENTER_CODE=
