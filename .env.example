# Copy to .env and fill in. .env is git-ignored.

# --- Copilot -----------------------------------------------------------------
# Without a key the copilot still works: it answers deterministically from the
# recorded evidence and labels itself as degraded rather than pretending.
OPENAI_API_KEY=
SIDEKICK_LLM_MODEL=gpt-5.4-mini
# Hard ceiling on tool calls per question. A bounded loop cannot run away.
SIDEKICK_MAX_TOOL_CALLS=8
SIDEKICK_LLM_TIMEOUT=60

# --- Runtime -----------------------------------------------------------------
# full   local, the pipeline is importable
# replay hosted, serves the committed evidence bundle only
SIDEKICK_MODE=full
SIDEKICK_LOG_LEVEL=INFO

# --- Paths (defaults are relative to the repository root) --------------------
# SIDEKICK_DATA_DIR=data
# SIDEKICK_ARTIFACTS_DIR=artifacts
# SIDEKICK_BUNDLE_PATH=evidence/bundle.json
# SIDEKICK_STATIC_DIR=frontend/dist

# --- Optional tracking -------------------------------------------------------
# The evidence store under artifacts/runs is the source of truth. MLflow is a
# mirror, and everything still works when it is not installed.
SIDEKICK_MLFLOW=1
# MLFLOW_TRACKING_URI=file:./mlruns

# --- Frontend ----------------------------------------------------------------
# Empty in development: Vite proxies /api to the local backend.
# VITE_API_BASE=
SIDEKICK_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
