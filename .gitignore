# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Node
node_modules/
frontend/dist/
frontend/.vite/

# Datasets are fetched by script, never committed.
/data/
!/data/.gitkeep

# MLflow local tracking. The committed evidence bundle under evidence/ is the
# durable record; mlruns/ is a local convenience mirror.
mlruns/
mlartifacts/

# Local run outputs. evidence/bundle.json is the durable, committed record; the
# run store under artifacts/ is a local working directory that each machine
# rebuilds for itself.
artifacts/*
!artifacts/.gitkeep

# Secrets and logs
.env
.env.local
install.log
*.log

# OS / editor
.playwright-cli/
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
