              "type": "array"
            },
            "alternative": {
              "description": "A genuinely different tentative mechanism compatible with the same evidence, distinguishable by the proposed diagnostic. Missing records are an uncertainty, not a mechanism.",
              "maxLength": 500,
              "minLength": 1,
              "title": "Alternative",
              "type": "string"
            }
          },
          "required": [
            "title",
            "explanation",
            "observation_ids",
            "alternative"
          ],
          "title": "ScopedDeepHypothesis",
          "type": "object"
        },
        "ScopedDiagnosticTest": {
          "additionalProperties": false,
          "properties": {
            "title": {
              "maxLength": 120,
              "minLength": 1,
              "title": "Title",
              "type": "string"
            },
            "model": {
              "description": "The model whose own score scale and records this check uses.",
              "enum": [
                "model-1",
                "model-2"
              ],
              "title": "Model",
              "type": "string"
            },
            "check_type": {
              "enum": [
                "score_persistence",
                "preprocessing_audit",
                "sensor_quality",
                "threshold_sensitivity",
                "recorded_attribution",
                "fold_variation"
              ],
              "title": "Check Type",
              "type": "string"
            },
            "focus": {
              "description": "Specific question this diagnostic should distinguish. Do not invent a procedure or assert a cause.",
              "maxLength": 260,
              "minLength": 1,
              "title": "Focus",
              "type": "string"
            },
            "signal": {
              "enum": [
                "scores_below_own_threshold",
                "crossings_without_warning",
                "preprocessing_contract_mismatch",
                "sensor_quality_anomaly",
                "attribution_concentration",
                "fold_outcome_concentration",
